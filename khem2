,e.renk,fs,S);
  });

  /* rüzgâr oku — kaynağın gerisinden gelir */
  const okU=Math.min(Math.max(enUzak*0.22,60/S),130/S);
  const bx=cx-ux*okU*1.9, by=cy-uy*okU*1.9;
  okCiz(hKtx,bx,by,cx-ux*okU*0.55,cy-uy*okU*0.55,koyuMu()?"#EAF2FF":"#16324F",4/S,15/S);
  const wfs=Math.max(9,12/S);
  hKtx.font="800 "+wfs+"px system-ui";
  const wtxt="RÜZGÂR "+sonHesap.u+" m/s";
  const wtw=hKtx.measureText(wtxt).width;
  etiketCiz(hKtx,bx-wtw/2,by-14/S,wtxt,koyuMu()?"#EAF2FF":"#16324F",wfs,S);

  /* kaynak noktası */
  const sr=11/S;
  hKtx.beginPath();hKtx.arc(cx,cy,sr,0,7);
  hKtx.fillStyle=koyuMu()?"#161F2A":"#FFFF";
  hKtx.strokeStyle=v.renk||"#C1121F";hKtx.lineWidth=3.5/S;
  hKtx.fill();hKtx.stroke();
  const cr=5.5/S;
  hKtx.strokeStyle=v.renk||"#C1121F";hKtx.lineWidth=2.6/S;
  hKtx.beginPath();
  hKtx.moveTo(cx-cr,cy);hKtx.lineTo(cx+cr,cy);
  hKtx.moveTo(cx,cy-cr);hKtx.lineTo(cx,cy+cr);
  hKtx.stroke();
  const kfs=Math.max(9,12.5/S);
  etiketCiz(hKtx,cx+sr+6/S,cy+kfs*0.38,`${v.duz||"?"} kaçak noktası`,v.renk||"#C1121F",kfs,S);
}

/* ════ SAĞ PANEL GÜNCELLEMELERİ ════ */
function spSonucGuncelle(){
  const el=document.getElementById("sp-sonuc-ic");
  if(!el) return;
  if(!sonHesap){
    el.innerHTML='<div class="sp-bos">📊 Hesaplama yapılmadı.</div>';
    return;
  }
  const v=KDB[sonHesap.kimyasal];
  const enUzak=Math.max(...sonHesap.hesaplar.map(e=>e.mesafe),1);
  let h=`<div style="display:flex;align-items:center;gap:7px;margin-bottom:7px">
    <span style="font-size:18px;font-weight:800;color:${v.renk}">${v.duz}</span>
    <span style="font-size:12px;color:var(--soluk)">${v.ad} · ${sonHesap.u} m/s · Sınıf ${sonHesap.sinif}</span>
  </div>`;
  for(const e of sonHesap.hesaplar){
    h+=`<div class="sp-bant" style="--bk:${e.renk}">
      <span class="ad">${e.ad} · ${e.ppm} ppm</span><span class="msf">${mYaz(e.mesafe)}</span>
    </div>`;
  }
  if(sonHesap.lelMesafe!=null&&sonHesap.lelMesafe>0){
    h+=`<div class="sp-bant" style="--bk:#2D7A46">
      <span class="ad">LEL · %${v.lfl}</span><span class="msf">${mYaz(sonHesap.lelMesafe)}</span>
    </div>`;
  }
  h+=`<button class="btn btn-ik btn-blok btn-kk" onclick="sayfaGec('sonuc')">Detaylı sonuç sayfası →</button>`;
  el.innerHTML=h;
  miniKanvasCiz();
}

/* ── NH₃ flaş buharlaşma notu (sağ panel) ── */
function spFlashNot(){
  const el=document.getElementById("sp-flash-not");
  if(!el)return;
  if(secKimyasal!=="NH3"||kaynak.mod==="anlik"){el.style.display="none";return;}
  const T_id=kaynak.mod==="tank"?"nh3DepoT2":"nh3DepoT";
  const T=parseFloat(document.getElementById(T_id)?.value)||25;
  const f=nh3FlashFrac(T);
  el.style.display="block";
  el.innerHTML="❄ Depo <b>"+T+" °C</b> → flaş oranı <b>%"+(f*100).toFixed(0)+"</b> · bulut yoğunluğu ≈ <b>"+nh3BulutYog(f).toFixed(2)+" kg/m³</b> — ağır gaz modeli uygulanır.";
